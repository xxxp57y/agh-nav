# Example paths only; fill in your own deployment and data environment.
AGH_MHS_BASE=/srv/agh-demo
AGH_MHS_RUNTIME=/srv/agh-demo/agh-mhs-runtime
AGH_MHS_NAVROOT=/srv/agh-demo/agh-nav
AGH_HABITAT_PYTHON=/path/to/habitat-env/bin/python
ROUTE1_REPO=/path/to/InternNav
NAVLIVE_REPO=/path/to/InternNav
NAVLIVE_CONFIG=/path/to/InternNav/scripts/eval/configs/habitat_dual_system_cfg.py
MULTISCENE_SPLIT=val_unseen
AGH_MHS_KEY_FILE=/srv/agh-demo/.secrets/agnes-key.txt
AGH_MHS_SCENE=zsNo4HB9uLZ
# Optional Windows SSH forwarding
AGH_MHS_SSH_HOST=your-user@your-server.example
AGH_MHS_SSH_PORT=22
AGH_MHS_SSH_KEY=C:/path/to/your/ssh/key
